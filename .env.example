# Public canonical origin. Use the production domain when deploying.
NEXT_PUBLIC_SITE_URL=https://www.thebenzzcreations.com

# The default preserves the current website's Web3Forms delivery integration.
# Its existing public access key is preserved. Enhanced submissions first use
# our API for validation, then POST from the browser to Web3Forms as required
# by its standard plan. Without JavaScript, direct email is available.
ENQUIRY_PROVIDER=web3forms
# Optional server handshake override. When replacing the business form key,
# keep public and server configuration values aligned when adding a native fallback.
WEB3FORMS_ACCESS_KEY=
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# SMTP credentials stay on the server. Never use NEXT_PUBLIC_ for these values.
# To use SMTP instead, set ENQUIRY_PROVIDER=smtp and fill every setting below.
# Configure an authenticated provider and an approved sender address.
# Port 465 uses implicit TLS; other ports require STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# When SMTP is selected without all settings, valid form submissions return
# 503 and the UI offers email and WhatsApp contact. Success requires positive
# acceptance by the selected provider; it does not guarantee inbox placement.
# SMTP recipient is fixed to the verified business email in lib/enquiry.ts.
# Check the Web3Forms account/domain restrictions before production launch.
# Native fallback uses browser validation and Web3Forms spam checks; the
# enhanced JavaScript flow also uses our server validation and rate limiting.
# Rate limiting is process-local and best effort. Production multi-instance
# deployments should add a shared edge limiter and replace client IP headers
# at the trusted reverse proxy; never trust client-supplied forwarded values.
# SEO metadata and optional Google integrations (set before building).
# Use only the verification token, not the complete meta tag.
GOOGLE_SITE_VERIFICATION=8MsySZqeSGdkv-ve9SoSqPVqLD5NZ5vmL2MfO2t8LVI
# Public GA4 ID already present on the live site. Visitors must opt in.
# Set an explicitly empty value to disable analytics. Rebuild after changes.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-Q9JRF078F9
# Alternative server/build variable if NEXT_PUBLIC_GA_MEASUREMENT_ID is unset.
GA4_MEASUREMENT_ID=
